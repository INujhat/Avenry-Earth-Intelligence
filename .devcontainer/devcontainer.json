{
  "name": "Avenry Earth Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "8gb" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Avenry Earth Intelligence website", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash scripts/bootstrap.sh",
  "postStartCommand": "bash .devcontainer/start-web.sh",
  "customizations": {
    "vscode": { "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" } }
  }
}
