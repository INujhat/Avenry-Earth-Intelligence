# DATABASE_URL=postgresql+psycopg://terrasense:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/terrasense
# Optional NASA asset access: provide securely in your shell/environment settings.
# EARTHDATA_TOKEN=
